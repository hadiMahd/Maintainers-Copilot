{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maintainer-copilot.local/contracts/eval-report.schema.json",
  "title": "Maintainer Copilot Evaluation Report",
  "type": "object",
  "required": [
    "run_id",
    "timestamp",
    "classifier",
    "rag",
    "storage",
    "passed"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "git_sha": {
      "type": ["string", "null"]
    },
    "thresholds": {
      "$ref": "#/$defs/thresholds"
    },
    "classifier": {
      "$ref": "#/$defs/classifier_result"
    },
    "rag": {
      "$ref": "#/$defs/rag_result"
    },
    "redaction": {
      "$ref": "#/$defs/gate_summary"
    },
    "static_secret_grep": {
      "$ref": "#/$defs/gate_summary"
    },
    "artifact_integrity": {
      "$ref": "#/$defs/gate_summary"
    },
    "startup": {
      "$ref": "#/$defs/gate_summary"
    },
    "tracing": {
      "$ref": "#/$defs/gate_summary"
    },
    "storage": {
      "type": "object",
      "required": ["bucket", "key"],
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "previous_green_comparison": {
      "type": "object",
      "required": ["available", "passed", "summary"],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "previous_report_uri": {
          "type": ["string", "null"]
        },
        "passed": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "regressions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "$defs": {
    "metric": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullable_metric": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "thresholds": {
      "type": "object",
      "required": [
        "enabled",
        "classifier_accuracy_min",
        "classifier_macro_f1_min",
        "rag_hit_at_5_min",
        "rag_mrr_at_10_min"
      ],
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": true
        },
        "classifier_accuracy_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "classifier_macro_f1_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rag_hit_at_5_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rag_mrr_at_10_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rag_faithfulness_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rag_answer_relevancy_min": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "classifier_result": {
      "type": "object",
      "required": ["accuracy", "macro_f1", "per_class_f1", "threshold"],
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": ["string", "null"]
        },
        "accuracy": {
          "$ref": "#/$defs/metric"
        },
        "macro_f1": {
          "$ref": "#/$defs/metric"
        },
        "per_class_f1": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metric"
          }
        },
        "threshold": {
          "$ref": "#/$defs/metric"
        },
        "passed": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latency": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "rag_result": {
      "type": "object",
      "required": [
        "hit_at_5",
        "mrr_at_10",
        "faithfulness",
        "answer_relevancy",
        "threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": ["string", "null"]
        },
        "hit_at_5": {
          "$ref": "#/$defs/metric"
        },
        "mrr_at_10": {
          "$ref": "#/$defs/metric"
        },
        "faithfulness": {
          "$ref": "#/$defs/metric"
        },
        "answer_relevancy": {
          "$ref": "#/$defs/metric"
        },
        "threshold": {
          "$ref": "#/$defs/metric"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "passed": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latency": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "number"
          }
        },
        "ragas": {
          "$ref": "#/$defs/ragas_result"
        }
      }
    },
    "ragas_result": {
      "type": "object",
      "required": ["enabled", "failures"],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "context_precision": {
          "$ref": "#/$defs/nullable_metric"
        },
        "context_recall": {
          "$ref": "#/$defs/nullable_metric"
        },
        "context_entity_recall": {
          "$ref": "#/$defs/nullable_metric"
        },
        "noise_sensitivity": {
          "$ref": "#/$defs/nullable_metric"
        },
        "faithfulness": {
          "$ref": "#/$defs/nullable_metric"
        },
        "response_relevancy": {
          "$ref": "#/$defs/nullable_metric"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "context_top_k": {
          "type": "integer",
          "minimum": 1
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate_summary": {
      "type": "object",
      "required": ["passed", "summary"],
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
