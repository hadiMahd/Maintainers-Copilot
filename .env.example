# === Core Infra Secrets / Runtime Config Seeded Into Vault ===
POSTGRES_DB=maintainer
POSTGRES_USER=maintainer
POSTGRES_PASSWORD=fake-postgres-password
APP_DATABASE_URL=postgresql+asyncpg://maintainer:fake-postgres-password@postgres:5432/maintainer
APP_REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=fake-minio-password
APP_MINIO_ENDPOINT=minio:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=fake-minio-password
JWT_SIGNING_KEY=fake-jwt-signing-key

AZURE_OPENAI_KEY=fake-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://example-resource.openai.azure.com/
AZURE_OPENAI_MODEL=fake-openai-model
AZURE_EMBEDDING_MODEL=text-embedding-3-small

# === LangSmith Tracing ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=fake-langsmith-api-key
LANGSMITH_PROJECT=week-7-copilot

# === HashiCorp Vault Bootstrap ===
# Start Vault with Docker Compose, then run
# `uv run python scripts/seed_vault_from_env.py .env` from the repo root.
# App containers still receive only VAULT_ADDR / VAULT_TOKEN and resolve the
# rest from Vault.
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# === Local pgAdmin (optional) ===
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
